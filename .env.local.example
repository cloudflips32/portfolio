# Gmail SMTP credentials for contact form
# 1. Enable 2-Factor Authentication at https://myaccount.google.com/security
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use your full Gmail address and the 16-char app password below

CONTACT_EMAIL_USER=<YOUR EMAIL>
CONTACT_EMAIL_PASS=your-16-char-app-password-here
CONTACT_EMAIL_TO=<YOUR EMAIL>